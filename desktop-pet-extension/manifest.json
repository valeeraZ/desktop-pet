{
  "manifest_version": 3,
  "name": "Desktop Pet MVP",
  "version": "0.1.0",
  "description": "Upload a pet image and spawn an animated companion on webpages.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "action": {
    "default_title": "Desktop Pet",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/pet-engine.js",
        "content/content.js"
      ],
      "css": [
        "content/panel.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
